# ---- Turso / libSQL -------------------------------------------------------
# Ottieni con:
#   turso db show fonticatastali --url
#   turso db tokens create fonticatastali
TURSO_DATABASE_URL="libsql://fonticatastali-<org>.turso.io"
TURSO_AUTH_TOKEN="<token>"

# ---- Hosting dei PDF ------------------------------------------------------
# In locale: lascia /docs (i file vanno in public/docs/<Cartella>/<file>.pdf)
# In produzione: URL pubblico del bucket (Cloudflare R2 / Vercel Blob / S3),
# es. https://pub-xxxx.r2.dev  oppure  https://<blob-store>.public.blob.vercel-storage.com
NEXT_PUBLIC_DOCS_BASE_URL="/docs"

# ---- Normie (chatbot RAG su Cloudflare) -----------------------------------
# ID account: dashboard Cloudflare -> menu laterale, oppure `wrangler whoami`.
CF_ACCOUNT_ID="<account-id>"
# Token API con permessi: Workers AI (Run), Vectorize (Read), D1 (Read).
# Crea in: My Profile -> API Tokens -> Create Token.
CF_API_TOKEN="<api-token>"
# Nome dell'indice Vectorize (creato con `wrangler vectorize create`).
CF_VECTORIZE_INDEX="normie-catasto"
# UUID del database D1 (da `wrangler d1 create` o dalla dashboard).
CF_D1_DATABASE_ID="<d1-database-id>"
# (Opzionali) override dei modelli.
CF_EMBEDDING_MODEL="@cf/baai/bge-m3"
CF_LLM_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
