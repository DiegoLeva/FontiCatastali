# ---- Turso / libSQL -------------------------------------------------------
# Ottieni con:
#   turso db show fonticatastali --url
#   turso db tokens create fonticatastali
TURSO_DATABASE_URL="libsql://fonticatastali-<org>.turso.io"
TURSO_AUTH_TOKEN="<token>"

# ---- Hosting dei PDF ------------------------------------------------------
# In locale: lascia /docs (i file vanno in public/docs/<Cartella>/<file>.pdf)
# In produzione: URL pubblico del bucket (Cloudflare R2 / Vercel Blob / S3),
# es. https://pub-xxxx.r2.dev  oppure  https://<blob-store>.public.blob.vercel-storage.com
NEXT_PUBLIC_DOCS_BASE_URL="/docs"
